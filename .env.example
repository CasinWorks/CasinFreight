# GEMINI_API_KEY: Optional. Only needed if you use Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Firebase (create a new project, then paste the web app config)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# PayMongo — use one of these (never put sk_ keys in VITE_ variables)
# 1) Payment Link from PayMongo Dashboard → Payment Links
VITE_PAYMONGO_PAYMENT_LINK=""
# 2) Test API keys from PayMongo Dashboard → Developers → API Keys
VITE_PAYMONGO_USE_API="true"
VITE_PAYMONGO_TEST_MODE="true"
PAYMONGO_SECRET_KEY=""
