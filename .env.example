# GEMINI_API_KEY: Optional. Only needed if you use Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Firebase (create a new project, then paste the web app config)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# PayMongo live checkout (never put sk_ keys in VITE_ variables).
# Use the Live secret from PayMongo → Developers → API Keys → Live.
# Founding charge is ₱899/month.
VITE_PAYMONGO_USE_API="true"
VITE_PAYMONGO_TEST_MODE="false"
PAYMONGO_SECRET_KEY=""

# Optional extra platform admin emails (comma-separated). Default includes christianjoshuacasin@gmail.com
VITE_PLATFORM_ADMIN_EMAILS=""

# Used by /api/paymongo to verify the signed-in Firebase user. Defaults to VITE_FIREBASE_API_KEY.
# FIREBASE_WEB_API_KEY=""
