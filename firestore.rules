rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function inCompany(companyId) {
      return signedIn()
        && exists(userPath())
        && userData().companyId == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function createdCompany(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid;
    }

    // Creator keeps bootstrap access only while their user profile still points here.
    function stillOwnsCreatedCompany(companyId) {
      return createdCompany(companyId)
        && (!exists(userPath()) || userData().companyId == companyId);
    }

    function isPlatformAdmin() {
      // Custom claim stamped by POST /api/session for Auth UIDs in api/platformAdminUids.js.
      // Do not grant by email. Do not use email_verified without a verify-email flow.
      return signedIn() && request.auth.token.admin == true;
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function subData(companyId) {
      return companyDoc(companyId).subscription;
    }

    function isFreePlan(companyId) {
      return !exists(/databases/$(database)/documents/companies/$(companyId))
        || !companyDoc(companyId).keys().hasAny(['subscription'])
        || !subData(companyId).keys().hasAny(['plan_id'])
        || subData(companyId).plan_id == 'plan_free';
    }

    function billedTrucks(companyId) {
      return subData(companyId).keys().hasAny(['billed_truck_count'])
        && subData(companyId).billed_truck_count is number
        ? int(subData(companyId).billed_truck_count)
        : 0;
    }

    function includedTruckCap(companyId) {
      return subData(companyId).keys().hasAny(['included_trucks'])
        && subData(companyId).included_trucks is number
        && int(subData(companyId).included_trucks) > 0
        ? int(subData(companyId).included_trucks)
        : (subData(companyId).keys().hasAny(['pricing_tier']) && subData(companyId).pricing_tier == 'list' ? 2 : 5);
    }

    function paidTruckCap(companyId) {
      return subData(companyId).keys().hasAny(['plan_id']) && subData(companyId).plan_id == 'plan_promo'
        ? (billedTrucks(companyId) > 0 ? billedTrucks(companyId) : 1)
        : (billedTrucks(companyId) > includedTruckCap(companyId) ? billedTrucks(companyId) : includedTruckCap(companyId));
    }

    function truckCapUnclamped(companyId) {
      return isFreePlan(companyId) ? 5 : paidTruckCap(companyId);
    }

    function truckCap(companyId) {
      return truckCapUnclamped(companyId) > 200
        ? 200
        : (truckCapUnclamped(companyId) < 1 ? 1 : truckCapUnclamped(companyId));
    }

    function isTruckSlot(id, companyId) {
      return id.matches('^slot-truck-(0|[1-9][0-9]{0,2})$')
        && int(id.split('-')[2]) < truckCap(companyId);
    }

    function storageAddonGb(companyId) {
      return subData(companyId).keys().hasAny(['storage_addon_gb'])
        && subData(companyId).storage_addon_gb is number
        && int(subData(companyId).storage_addon_gb) > 0
        ? int(subData(companyId).storage_addon_gb)
        : 0;
    }

    function storageBaseGb(companyId) {
      return subData(companyId).keys().hasAny(['plan_id'])
        && (subData(companyId).plan_id == 'plan_founding' || subData(companyId).plan_id == 'plan_promo')
        ? 5
        : 2;
    }

    function storageCapBytes(companyId) {
      return (storageBaseGb(companyId) + storageAddonGb(companyId)) * 1024 * 1024 * 1024;
    }

    // Warehouse / client portal logins share companyId but are not team seats.
    // Keep them out of canAccessCompany so the catch-all subcollection rule
    // cannot list every company trip/invoice.
    function isClientPortalUser() {
      return signedIn()
        && exists(userPath())
        && userData().keys().hasAny(['clientId'])
        && userData().clientId is string
        && userData().clientId.size() > 0
        && (
          (
            userData().keys().hasAny(['kind'])
            && userData().kind is string
            && userData().kind.lower() == 'client_portal'
          )
          || (
            userData().role is string
            && userData().role.lower() == 'client'
          )
        );
    }

    // Trip list for portal: query must be where('clientId' == user.clientId).
    function portalMayReadTrip(companyId) {
      return signedIn()
        && exists(userPath())
        && userData().companyId == companyId
        && userData().keys().hasAny(['clientId'])
        && userData().clientId is string
        && userData().clientId.size() > 0
        && resource.data.keys().hasAny(['clientId'])
        && resource.data.clientId is string
        && resource.data.clientId == userData().clientId
        && (
          (
            userData().keys().hasAny(['kind'])
            && userData().kind is string
            && userData().kind.lower() == 'client_portal'
          )
          || (
            userData().role is string
            && userData().role.lower() == 'client'
          )
        );
    }

    function canAccessCompany(companyId) {
      return (inCompany(companyId) && !isClientPortalUser())
        || stillOwnsCreatedCompany(companyId)
        || isPlatformAdmin();
    }

    function isOwnerLike() {
      return signedIn()
        && exists(userPath())
        && userData().role is string
        && userData().role.lower().matches('^owner');
    }

    function isCompanyOwner(companyId) {
      return isPlatformAdmin()
        || (inCompany(companyId) && isOwnerLike())
        || stillOwnsCreatedCompany(companyId);
    }

    function matchingInvite(companyId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/invites/$(authEmail()))
        && get(/databases/$(database)/documents/invites/$(authEmail())).data.companyId == companyId;
    }

    function inviteRole() {
      return get(/databases/$(database)/documents/invites/$(authEmail())).data.role;
    }

    function inviteKind() {
      return get(/databases/$(database)/documents/invites/$(authEmail())).data.keys().hasAny(['kind'])
        ? get(/databases/$(database)/documents/invites/$(authEmail())).data.kind
        : 'team';
    }

    function inviteClientId() {
      return get(/databases/$(database)/documents/invites/$(authEmail())).data.clientId;
    }

    function isClientPortalFor(companyId) {
      return isClientPortalUser() && userData().companyId == companyId;
    }

    function portalClientId() {
      return userData().clientId;
    }

    function roleDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/roles/$(userData().role)).data;
    }

    function hasPerm(companyId, perm) {
      return isPlatformAdmin()
        || isOwnerLike()
        || (
          inCompany(companyId)
          && exists(/databases/$(database)/documents/companies/$(companyId)/roles/$(userData().role))
          && roleDoc(companyId).keys().hasAny(['permissions'])
          && roleDoc(companyId).permissions.hasAny([perm])
        );
    }

    function tripPath(companyId, tripId) {
      return /databases/$(database)/documents/companies/$(companyId)/trips/$(tripId);
    }

    function isAssignedTripDriver(companyId, tripId) {
      return inCompany(companyId)
        && exists(tripPath(companyId, tripId))
        && get(tripPath(companyId, tripId)).data.keys().hasAny(['driverId'])
        && exists(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId))
        && (
          (
            get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId)).data.keys().hasAny(['email'])
            && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId)).data.email is string
            && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId)).data.email.lower() == authEmail()
          )
          || (
            get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId)).data.keys().hasAny(['userId'])
            && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(get(tripPath(companyId, tripId)).data.driverId)).data.userId == request.auth.uid
          )
        );
    }

    function canWriteTrip(companyId, tripId) {
      return hasPerm(companyId, 'trips.edit')
        || hasPerm(companyId, 'trips.create')
        || hasPerm(companyId, 'trips.reassign_fleet')
        || hasPerm(companyId, 'trips.status_pending')
        || hasPerm(companyId, 'trips.status_loaded')
        || hasPerm(companyId, 'trips.status_in_transit')
        || hasPerm(companyId, 'trips.status_invoiced')
        || isAssignedTripDriver(companyId, tripId);
    }

    function isFieldDriverMember() {
      return signedIn()
        && exists(userPath())
        && userData().role is string
        && userData().role.lower() == 'driver';
    }

    function canReadAllCompanyTrips(companyId) {
      return isPlatformAdmin()
        || isCompanyOwner(companyId)
        || hasPerm(companyId, 'trips.create')
        || hasPerm(companyId, 'trips.edit')
        || hasPerm(companyId, 'trips.reassign_fleet')
        || hasPerm(companyId, 'invoices.create')
        || hasPerm(companyId, 'ledger.view')
        || hasPerm(companyId, 'dashboard.view')
        || hasPerm(companyId, 'fleet.view')
        || hasPerm(companyId, 'drivers.approve')
        || hasPerm(companyId, 'ratecards.manage');
    }

    function currentStorageUsed() {
      return resource.data.keys().hasAny(['storageUsedBytes']) && resource.data.storageUsedBytes is number
        ? int(resource.data.storageUsedBytes)
        : 0;
    }

    function storageUsageWithinPlan(companyId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storageUsedBytes'])
        || (
          request.resource.data.storageUsedBytes is number
          && int(request.resource.data.storageUsedBytes) >= currentStorageUsed()
          && int(request.resource.data.storageUsedBytes) - currentStorageUsed() < 8 * 1024 * 1024
          && int(request.resource.data.storageUsedBytes) <= storageCapBytes(companyId)
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isPlatformAdmin() ||
        (exists(userPath()) && resource.data.companyId == userData().companyId)
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId is string
        && (
          stillOwnsCreatedCompany(request.resource.data.companyId)
          || (
            matchingInvite(request.resource.data.companyId)
            && !isFreePlan(request.resource.data.companyId)
            && inviteKind() != 'client_portal'
            && !(inviteRole() is string && inviteRole().lower() == 'client')
            && request.resource.data.role == inviteRole()
            && request.resource.data.role.lower() != 'owner'
          )
          || (
            matchingInvite(request.resource.data.companyId)
            && !isFreePlan(request.resource.data.companyId)
            && (
              inviteKind() == 'client_portal'
              || (inviteRole() is string && inviteRole().lower() == 'client')
            )
            && request.resource.data.kind == 'client_portal'
            && request.resource.data.role == 'Client'
            && request.resource.data.clientId is string
            && request.resource.data.clientId == inviteClientId()
          )
        );

      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.role == resource.data.role
        )
        || (
          isCompanyOwner(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId
        )
        || isPlatformAdmin()
      );

      allow delete: if signedIn() && (
        request.auth.uid == uid ||
        isPlatformAdmin() ||
        (resource != null && isCompanyOwner(resource.data.companyId))
      );
    }

    match /invites/{email} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow create, update: if signedIn()
        && isCompanyOwner(request.resource.data.companyId)
        && !isFreePlan(request.resource.data.companyId)
        && request.resource.data.role is string
        && request.resource.data.role.lower() != 'owner';
      allow delete: if signedIn() && (
        resource == null ||
        isCompanyOwner(resource.data.companyId) ||
        (request.auth.token.email is string && request.auth.token.email.lower() == email)
      );
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == companyId
        && request.resource.data.subscriptionTier == 'Free'
        && request.resource.data.subscription.plan_id == 'plan_free';
      // Invitees need company read while claiming a seat (before members/{uid} exists).
      // Client portal users need company read for trip queries after join.
      allow read: if canAccessCompany(companyId)
        || matchingInvite(companyId)
        || isClientPortalFor(companyId);
      allow update: if isPlatformAdmin()
        || (
          canAccessCompany(companyId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscription', 'subscriptionTier', 'createdBy', 'id', 'salesAgentId'])
          && storageUsageWithinPlan(companyId)
          && (
            isCompanyOwner(companyId)
            || hasPerm(companyId, 'settings.manage')
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storageUsedBytes'])
          )
        );
      allow delete: if isCompanyOwner(companyId);

      match /members/{memberId} {
        allow read: if canAccessCompany(companyId);
        allow create: if isCompanyOwner(companyId)
          || (
            signedIn()
            && request.auth.uid == memberId
            && matchingInvite(companyId)
            && !isFreePlan(companyId)
            && inviteKind() != 'client_portal'
            && !(inviteRole() is string && inviteRole().lower() == 'client')
            && request.resource.data.role == inviteRole()
            && request.resource.data.role.lower() != 'owner'
          );
        allow update: if isCompanyOwner(companyId)
          || (
            inCompany(companyId)
            && request.auth.uid == memberId
            && request.resource.data.role == resource.data.role
            && request.resource.data.companyId == resource.data.companyId
          );
        allow delete: if isCompanyOwner(companyId) || request.auth.uid == memberId;
      }

      match /roles/{roleId} {
        allow read: if canAccessCompany(companyId);
        allow create: if isCompanyOwner(companyId)
          && (isPlatformAdmin() || !isFreePlan(companyId) || roleId == 'Owner');
        allow update, delete: if isCompanyOwner(companyId);
      }

      match /trips/{tripId} {
        allow read: if portalMayReadTrip(companyId)
          || (
            canAccessCompany(companyId)
            && (
              canReadAllCompanyTrips(companyId)
              || (!isFieldDriverMember() && hasPerm(companyId, 'trips.view'))
              || isAssignedTripDriver(companyId, tripId)
            )
          );
        allow create: if hasPerm(companyId, 'trips.create')
          && (isPlatformAdmin() || !isFreePlan(companyId) || tripId.matches('^slot-trip-[0-9]$'));
        allow update: if canWriteTrip(companyId, tripId)
          || (
            isClientPortalFor(companyId)
            && resource.data.clientId == portalClientId()
            && request.resource.data.clientId == resource.data.clientId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pod', 'status', 'actualDelivery', 'timeline'])
            && request.resource.data.status == 'Delivered'
          );
        allow delete: if hasPerm(companyId, 'trips.delete');
      }

      match /invoices/{docId} {
        allow read: if canAccessCompany(companyId);
        allow create, update: if hasPerm(companyId, 'invoices.create') || hasPerm(companyId, 'invoices.retract');
        allow delete: if isCompanyOwner(companyId);
      }

      match /journalEntries/{docId} {
        allow read: if canAccessCompany(companyId);
        allow write: if hasPerm(companyId, 'ledger.post_jv');
      }

      match /fuelLogs/{docId} {
        allow read: if canAccessCompany(companyId);
        allow create, update: if hasPerm(companyId, 'fuel.log');
        allow delete: if hasPerm(companyId, 'fuel.delete') || isCompanyOwner(companyId);
      }

      match /trucks/{docId} {
        allow read: if canAccessCompany(companyId);
        allow create: if hasPerm(companyId, 'fleet.crud')
          && (isPlatformAdmin() || isTruckSlot(docId, companyId));
        allow update, delete: if hasPerm(companyId, 'fleet.crud');
      }

      match /drivers/{docId} {
        allow read: if canAccessCompany(companyId);
        allow create, update: if hasPerm(companyId, 'drivers.crud')
          || (
            inCompany(companyId)
            && request.resource.data.email is string
            && request.resource.data.email.lower() == authEmail()
            && (
              !request.resource.data.keys().hasAny(['userId'])
              || request.resource.data.userId == request.auth.uid
            )
            && (
              !('crewRole' in request.resource.data)
              || request.resource.data.crewRole == 'driver'
            )
          );
        allow delete: if hasPerm(companyId, 'drivers.crud');
      }

      match /clients/{docId} {
        allow read: if canAccessCompany(companyId)
          || (
            isClientPortalFor(companyId)
            && docId == portalClientId()
          );
        allow create: if hasPerm(companyId, 'ratecards.manage') || hasPerm(companyId, 'settings.manage');
        allow update: if hasPerm(companyId, 'ratecards.manage') || hasPerm(companyId, 'settings.manage')
          || (
            signedIn()
            && matchingInvite(companyId)
            && (
              inviteKind() == 'client_portal'
              || (inviteRole() is string && inviteRole().lower() == 'client')
            )
            && inviteClientId() == docId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['portalUserId', 'portalStatus', 'portalEmail', 'portalInvitedAt', 'portalAgents'])
            && request.resource.data.portalUserId == request.auth.uid
            && request.resource.data.portalStatus == 'active'
          )
          || (
            isClientPortalFor(companyId)
            && docId == portalClientId()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['portalUserId', 'portalStatus', 'portalEmail', 'portalInvitedAt', 'portalAgents'])
            && request.resource.data.portalUserId == request.auth.uid
            && request.resource.data.portalStatus == 'active'
          );
        allow delete: if hasPerm(companyId, 'ratecards.manage') || hasPerm(companyId, 'settings.manage');
      }

      match /rateCards/{docId} {
        allow read: if canAccessCompany(companyId);
        allow write: if hasPerm(companyId, 'ratecards.manage');
      }

      match /truckBans/{docId} {
        allow read: if canAccessCompany(companyId);
        allow write: if hasPerm(companyId, 'fleet.crud') || hasPerm(companyId, 'settings.manage');
      }

      match /fieldEvents/{docId} {
        allow read: if (
            canAccessCompany(companyId)
            && (
              canReadAllCompanyTrips(companyId)
              || (!isFieldDriverMember() && hasPerm(companyId, 'trips.view'))
              || (
                resource.data.tripId is string
                && isAssignedTripDriver(companyId, resource.data.tripId)
              )
            )
          )
          || (
            isClientPortalFor(companyId)
            && resource.data.keys().hasAny(['clientId'])
            && resource.data.clientId == portalClientId()
          )
          || (
            isClientPortalFor(companyId)
            && resource.data.tripId is string
            && exists(tripPath(companyId, resource.data.tripId))
            && get(tripPath(companyId, resource.data.tripId)).data.clientId == portalClientId()
          );
        allow create, update: if request.resource.data.tripId is string
          && (
            canWriteTrip(companyId, request.resource.data.tripId)
            || isAssignedTripDriver(companyId, request.resource.data.tripId)
            || (
              isClientPortalFor(companyId)
              && exists(tripPath(companyId, request.resource.data.tripId))
              && get(tripPath(companyId, request.resource.data.tripId)).data.clientId == portalClientId()
              && request.resource.data.kind in ['pod_signature', 'delivery_geo']
              && request.resource.data.clientId == portalClientId()
            )
          );
        allow delete: if isCompanyOwner(companyId);
      }

      match /liveTracking/{tripId} {
        allow read: if (
            canAccessCompany(companyId)
            && (
              canReadAllCompanyTrips(companyId)
              || (!isFieldDriverMember() && hasPerm(companyId, 'trips.view'))
              || isAssignedTripDriver(companyId, tripId)
            )
          )
          || (
            isClientPortalFor(companyId)
            && exists(tripPath(companyId, tripId))
            && get(tripPath(companyId, tripId)).data.clientId == portalClientId()
          );
        allow create, update: if isAssignedTripDriver(companyId, tripId)
          || hasPerm(companyId, 'trips.edit');
        allow delete: if isCompanyOwner(companyId);
      }

      match /notifications/{docId} {
        allow read: if canAccessCompany(companyId);
        allow write: if inCompany(companyId) || isPlatformAdmin();
      }

      match /auditLogs/{docId} {
        allow read: if canAccessCompany(companyId);
        allow create: if isCompanyOwner(companyId) || hasPerm(companyId, 'rbac.manage');
        allow update, delete: if isCompanyOwner(companyId);
      }

      match /{subcol}/{docId} {
        // Never use this catch-all for warehouse portal — they must use
        // collection-specific rules (trips/clients/fieldEvents/liveTracking).
        allow read: if canAccessCompany(companyId) && !isClientPortalUser();
        allow write: if false;
      }
    }

    match /platformNotices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /salesAgents/{agentId} {
      allow read, write: if isPlatformAdmin();
      match /{subcol}/{docId} {
        allow read, write: if isPlatformAdmin();
      }
    }
  }
}
