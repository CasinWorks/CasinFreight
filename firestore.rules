rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function inCompany(companyId) {
      return signedIn()
        && exists(userPath())
        && userData().companyId == companyId;
    }

    function createdCompany(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid;
    }

    function canAccessCompany(companyId) {
      return inCompany(companyId) || createdCompany(companyId);
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in ['christianjoshuacasin@gmail.com'];
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function matchingInvite(companyId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/invites/$(authEmail()))
        && get(/databases/$(database)/documents/invites/$(authEmail())).data.companyId == companyId;
    }

    function isCompanyOwner(companyId) {
      return createdCompany(companyId) || isPlatformAdmin();
    }

    function currentStorageUsed() {
      return resource.data.keys().hasAny(['storageUsedBytes']) && resource.data.storageUsedBytes is int
        ? resource.data.storageUsedBytes
        : 0;
    }

    // Members may raise usage by at most one 8 MB upload. They cannot zero the meter.
    function storageUsageNotDecreased() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storageUsedBytes'])
        || (
          request.resource.data.storageUsedBytes is int
          && request.resource.data.storageUsedBytes >= currentStorageUsed()
          && request.resource.data.storageUsedBytes - currentStorageUsed() < 8 * 1024 * 1024
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (exists(userPath()) && resource.data.companyId == userData().companyId)
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId is string
        && (
          createdCompany(request.resource.data.companyId) ||
          matchingInvite(request.resource.data.companyId)
        );

      // Members cannot jump companies or self-promote. The company creator can
      // update teammate profiles, including role, but cannot change companyId.
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.role == resource.data.role
        )
        || (
          createdCompany(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId
        )
        || isPlatformAdmin()
      );

      allow delete: if signedIn() && (
        request.auth.uid == uid ||
        createdCompany(resource.data.companyId) ||
        isPlatformAdmin()
      );
    }

    match /invites/{email} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow create, update: if signedIn() && isCompanyOwner(request.resource.data.companyId);
      allow delete: if signedIn() && (
        isCompanyOwner(resource.data.companyId) ||
        (request.auth.token.email is string && request.auth.token.email.lower() == email)
      );
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == companyId
        && request.resource.data.subscriptionTier == 'Free'
        && request.resource.data.subscription.plan_id == 'plan_free';
      allow read: if canAccessCompany(companyId) || isPlatformAdmin();
      // Billing is server-only (PayMongo verify via Admin SDK). Platform admin can still grant/revoke in the console.
      allow update: if isPlatformAdmin()
        || (
          canAccessCompany(companyId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscription', 'subscriptionTier', 'createdBy', 'id', 'salesAgentId'])
          && storageUsageNotDecreased()
        );
      allow delete: if isCompanyOwner(companyId);

      match /members/{memberId} {
        allow read: if canAccessCompany(companyId) || isPlatformAdmin();
        allow create: if isCompanyOwner(companyId)
          || (
            inCompany(companyId)
            && request.auth.uid == memberId
            && matchingInvite(companyId)
          );
        allow update: if isCompanyOwner(companyId)
          || (
            inCompany(companyId)
            && request.auth.uid == memberId
            && request.resource.data.role == resource.data.role
            && request.resource.data.companyId == resource.data.companyId
          );
        allow delete: if isCompanyOwner(companyId);
      }

      match /roles/{roleId} {
        allow read: if canAccessCompany(companyId) || isPlatformAdmin();
        allow write: if isCompanyOwner(companyId);
      }

      match /{subcol}/{docId} {
        allow read: if canAccessCompany(companyId) || isPlatformAdmin();
        allow write: if canAccessCompany(companyId)
          && subcol != 'members'
          && subcol != 'roles';
      }
    }

    match /platformNotices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /salesAgents/{agentId} {
      allow read, write: if isPlatformAdmin();
      match /{subcol}/{docId} {
        allow read, write: if isPlatformAdmin();
      }
    }
  }
}
