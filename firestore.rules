rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function inCompany(companyId) {
      return signedIn()
        && exists(userPath())
        && userData().companyId == companyId;
    }

    function createdCompany(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid;
    }

    function canAccessCompany(companyId) {
      return inCompany(companyId) || createdCompany(companyId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (exists(userPath()) && resource.data.companyId == userData().companyId)
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId is string;
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{email} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow create, update: if signedIn() && canAccessCompany(request.resource.data.companyId);
      allow delete: if signedIn() && (
        canAccessCompany(resource.data.companyId) ||
        (request.auth.token.email is string && request.auth.token.email.lower() == email)
      );
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id == companyId;
      allow read, update: if canAccessCompany(companyId);
      allow delete: if inCompany(companyId);

      match /{document=**} {
        allow read, write: if canAccessCompany(companyId);
      }
    }
  }
}
